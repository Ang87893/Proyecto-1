import random
import re
persona = {}

def generar_dni():
    letras = "TRWAGMYFPDXBNJZSQVHLCKE"

    numero = random.randint(0, 99999999)
    letra = letras[numero % 23]
    
    dni = f"{numero:08d}{letra}"

    return dni

def insertarRegistro():
    bucle = True
    while(bucle):
        try:
            nombre = input("Introduce el nombre: ").strip()
            if (not re.match(r'^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$', nombre)):
                raise ValueError("Error: Solo se admiten nombres reales (letras y espacios).")
            if (any(nombre.lower() == n.lower() for n in persona.values())):
                raise ValueError("Error: Ese nombre ya está registrado.")

            dni = generar_dni()
            persona[dni] = nombre
            print(f"Registro guardado: Nombre: {nombre} | DNI: {dni}")
            bucle = False
            return persona

        except ValueError as e:
            print(e)
            continue

