import random
import re
persona = {}

def generar_dni():
    letras = "TRWAGMYFPDXBNJZSQVHLCKE"

    numero = random.randint(0, 99999999)
    letra = letras[numero % 23]
    
    dni = f"{numero:08d}{letra}"

    return dni

def insertarRegistro():
    bucle = True
    while(bucle):
        try:
            nombre = input("Introduce el nombre: ").strip()
            if (not re.match(r'^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$', nombre)):
                raise ValueError("Error: Solo se admiten nombres reales (letras y espacios).")
            if (any(nombre.lower() == n.lower() for n in persona.values())):
                raise ValueError("Error: Ese nombre ya está registrado.")

            dni = generar_dni()
            persona[dni] = nombre
            print(f"Registro guardado: Nombre: {nombre} | DNI: {dni}")
            bucle = False
            return persona

        except ValueError as e:
            print(e)
            continue

def buscarPersona():
    bucle = True
    while(bucle):   
        try:
            num = int(input("Buscar por DNI (1) o nombre (2)"))
            if(num == 1):
                try:
                    dni_buscado = input("Escribe el DNI: ").strip().upper()
                    if dni_buscado in persona:
                        print(f"Encontrado -> DNI: {dni_buscado} | Nombre: {persona[dni_buscado]}")
                        bucle = False
                    else:
                        raise ValueError
                except ValueError:
                    print("Error: No existe esta persona")
            elif(num == 2):
                try:
                    nombre_buscado = input("Escribe el Nombre: ").strip().lower()
                    encontrado = False
                    for dni, nombre in persona.items():
                        if nombre.lower() == nombre_buscado:
                            print(f"Encontrado -> DNI: {dni} | Nombre: {persona[dni]}")
                            encontrado = True
                            bucle = False

                        if not encontrado:
                            raise ValueError
                except ValueError:
                    print("Error: No existe esta persona")
            else:
                raise ValueError

        except ValueError:
            print("Error:elige una de las opciones validas")
            continue

